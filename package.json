{
  "name": "mintransfer",
  "productName": "MinTransfer",
  "version": "1.0.3",
  "description": "Back up, restore, recover and erase iPhone and Android phones from macOS and Windows. Local, open source, no accounts.",
  "author": "Binwin Viju",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "swift scripts/make-icons.swift build",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "bundle:ios-tools": "bash scripts/bundle-ios-tools-mac.sh",
    "dist:mac-arm64": "npm run build && electron-builder --mac --arm64 --publish never",
    "dist:mac-x64": "npm run build && electron-builder --mac --x64 --publish never"
  },
  "dependencies": {
    "plist": "^3.1.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "com.mintransfer.app",
    "productName": "MinTransfer",
    "copyright": "Copyright © 2026 Binwin Viju",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "MinTransfer ${version}",
      "artifactName": "MinTransfer-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "MinTransfer-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MinTransfer",
      "uninstallDisplayName": "MinTransfer",
      "license": "build/license.txt"
    },
    "extraResources": [
      {
        "from": "vendor/tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  }
}
